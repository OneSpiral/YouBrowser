{
  "name": "youbrowser",
  "version": "0.1.0",
  "description": "Evidence-first acceptance runtime for agent and software outputs.",
  "type": "module",
  "bin": {
    "youbrowser": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify:example": "bun run src/cli.ts verify examples/web.json",
    "prepare": "bun run build"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.15.34",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "acceptance",
    "agent",
    "browser",
    "evidence",
    "playwright",
    "verification"
  ]
}
